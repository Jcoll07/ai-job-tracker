{
  "name": "ai-job-tracker",
  "private": true,
  "version": "2.0.0",
  "workspaces": ["packages/*", "apps/web"],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=apps/web",
    "build:extension": "npm run build --workspace=apps/extension",
    "package:macos": "node scripts/macos/package-jobtrackr.mjs",
    "test:macos-launcher": "bash scripts/macos/test-launcher-template.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:e2e": "sh scripts/e2e-local.sh",
    "test:security": "sh scripts/security-smoke.sh",
    "test:security:unit": "node --experimental-strip-types scripts/security-unit.ts",
    "verify:local": "sh scripts/local-verify.sh"
  },
  "engines": { "node": ">=22.13.0" }
}
