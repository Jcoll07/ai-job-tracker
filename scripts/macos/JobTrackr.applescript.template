property projectDir : "__PROJECT_DIR__"
property appPort : "3001"
property pidFile : projectDir & "/.jobtrackr-server.pid"
property logFile : projectDir & "/.jobtrackr-server.log"
property buildCommitFile : projectDir & "/.jobtrackr-build-commit"

on run
    set serverReady to my ensureServer()
    if serverReady then
        do shell script "open -a Safari http://127.0.0.1:" & appPort
    else
        set logHint to ""
        try
            set logTail to do shell script "/usr/bin/tail -n 12 " & quoted form of logFile
            set logHint to return & return & logTail
        end try
        display alert "JobTrackr no se pudo iniciar" message "No se pudo arrancar el servidor local en el puerto " & appPort & "." & logHint as warning
    end if
end run

on ensureServer()
    set serverRunning to do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectDir & " || exit 1; export PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\"; currentCommit=$(git rev-parse HEAD 2>/dev/null || echo unknown); builtCommit=$(cat " & quoted form of buildCommitFile & " 2>/dev/null || echo ''); if [ -f " & quoted form of pidFile & " ] && kill -0 $(cat " & quoted form of pidFile & ") 2>/dev/null && /usr/bin/curl -s -o /dev/null --max-time 2 http://127.0.0.1:" & appPort & "; then runtimeOk=yes; (cd apps/web && node -e \"require('better-sqlite3')\") >/dev/null 2>&1 || runtimeOk=no; if [ \"$currentCommit\" = \"$builtCommit\" ] && [ \"$runtimeOk\" = \"yes\" ]; then echo yes; else echo 'Source or native runtime changed; stopping stale JobTrackr server.' >> " & quoted form of logFile & "; kill $(cat " & quoted form of pidFile & ") 2>/dev/null || true; rm -f " & quoted form of pidFile & "; echo no; fi; else echo no; fi")
    if serverRunning is "yes" then return my waitForServer()

    set launchCommand to "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectDir & " || exit 1; export PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\"; command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1 || { echo 'Node.js/npm no están disponibles en el entorno de macOS.' >> " & quoted form of logFile & "; exit 127; }; if [ ! -d node_modules ] || [ ! -x node_modules/.bin/next ]; then echo 'Instalando dependencias sin ejecutar binarios nativos incompatibles...' >> " & quoted form of logFile & "; npm install --package-lock=false --save=false --ignore-scripts >> " & quoted form of logFile & " 2>&1 || exit $?; fi; cd apps/web || exit 1; sqliteVersion=$(node -p 'try { require(\"better-sqlite3/package.json\").version } catch { \"missing\" }'); if [[ \"$sqliteVersion\" != 13.* ]]; then echo 'Preparando better-sqlite3 13.0.3 (N-API, compatible con Node 22+)...' >> " & quoted form of logFile & "; npm install --package-lock=false --save=false better-sqlite3@13.0.3 >> " & quoted form of logFile & " 2>&1 || exit $?; fi; if ! node -e \"require('better-sqlite3')\" >/dev/null 2>&1; then echo 'Reinstalando better-sqlite3 13.0.3 para corregir el binario nativo...' >> " & quoted form of logFile & "; rm -rf node_modules/better-sqlite3; npm install --package-lock=false --save=false better-sqlite3@13.0.3 >> " & quoted form of logFile & " 2>&1 || exit $?; fi; node -e \"require('better-sqlite3')\" >/dev/null 2>&1 || { echo 'better-sqlite3 no se puede cargar con el Node.js activo.' >> " & quoted form of logFile & "; exit 1; }; cd " & quoted form of projectDir & " || exit 1; currentCommit=$(git rev-parse HEAD 2>/dev/null || echo unknown); builtCommit=$(cat " & quoted form of buildCommitFile & " 2>/dev/null || echo ''); if [ ! -f apps/web/.next/BUILD_ID ] || [ \"$currentCommit\" != \"$builtCommit\" ]; then echo \"Generando build de producción para $currentCommit...\" >> " & quoted form of logFile & "; npm run build >> " & quoted form of logFile & " 2>&1 || exit $?; printf '%s' \"$currentCommit\" > " & quoted form of buildCommitFile & "; fi; nohup npm run start --workspace=apps/web >> " & quoted form of logFile & " 2>&1 < /dev/null & echo $! > " & quoted form of pidFile)
    do shell script launchCommand
    return my waitForServer()
end ensureServer

on waitForServer()
    repeat 60 times
        try
            set statusCode to do shell script "/usr/bin/curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:" & appPort
            if statusCode is "200" or statusCode is "301" or statusCode is "302" or statusCode is "304" or statusCode is "307" or statusCode is "308" then return true
        end try
        delay 0.5
    end repeat
    return false
end waitForServer
