property projectDir : "__PROJECT_DIR__"
property appPort : "3001"
property pidFile : projectDir & "/.jobtrackr-server.pid"
property logFile : projectDir & "/.jobtrackr-server.log"
property buildCommitFile : projectDir & "/.jobtrackr-build-commit"

on run
    set serverReady to my ensureServer()
    if serverReady then
        do shell script "open -a Safari http://127.0.0.1:" & appPort
    else
        set logHint to ""
        try
            set logTail to do shell script "/usr/bin/tail -n 20 " & quoted form of logFile
            set logHint to return & return & logTail
        end try
        display alert "JobTrackr no se pudo iniciar" message "No se pudo arrancar el servidor local en el puerto " & appPort & "." & logHint as warning
    end if
end run

on ensureServer()
    set serverRunning to do shell script "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectDir & " || exit 1; export PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\"; NVM_DIR=\"$HOME/.nvm\"; if [ -s \"$NVM_DIR/nvm.sh\" ]; then . \"$NVM_DIR/nvm.sh\"; nvm use 22.23.2 >/dev/null 2>&1 || true; fi; NODE_BIN=$(command -v node 2>/dev/null || true); nativeOk=no; if [ -n \"$NODE_BIN\" ] && [ \"$($NODE_BIN -p 'process.versions.node.split(\".\")[0]')\" = \"22\" ]; then if \"$NODE_BIN\" -e \"require('better-sqlite3')\" >/dev/null 2>&1; then nativeOk=yes; fi; fi; currentCommit=$(git rev-parse HEAD 2>/dev/null || echo unknown); builtCommit=$(cat " & quoted form of buildCommitFile & " 2>/dev/null || echo ''); if [ \"$nativeOk\" = \"yes\" ] && [ -f " & quoted form of pidFile & " ] && kill -0 $(cat " & quoted form of pidFile & ") 2>/dev/null && /usr/bin/curl -s -o /dev/null --max-time 2 http://127.0.0.1:" & appPort & "; then if [ \"$currentCommit\" = \"$builtCommit\" ]; then echo yes; else echo 'Source changed; stopping stale JobTrackr server.' >> " & quoted form of logFile & "; kill $(cat " & quoted form of pidFile & ") 2>/dev/null || true; rm -f " & quoted form of pidFile & "; echo no; fi; else if [ -f " & quoted form of pidFile & " ] && kill -0 $(cat " & quoted form of pidFile & ") 2>/dev/null; then echo 'Stopping existing JobTrackr server before runtime validation.' >> " & quoted form of logFile & "; kill $(cat " & quoted form of pidFile & ") 2>/dev/null || true; fi; rm -f " & quoted form of pidFile & "; echo no; fi")
    if serverRunning is "yes" then return my waitForServer()

    set launchCommand to "/bin/zsh -lc " & quoted form of ("cd " & quoted form of projectDir & " || exit 1; export PATH=\"/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH\"; NVM_DIR=\"$HOME/.nvm\"; if [ -s \"$NVM_DIR/nvm.sh\" ]; then . \"$NVM_DIR/nvm.sh\"; nvm use 22.23.2 >/dev/null 2>&1 || true; fi; NODE_BIN=$(command -v node 2>/dev/null || true); NPM_BIN=$(command -v npm 2>/dev/null || true); if [ -z \"$NODE_BIN\" ] || [ -z \"$NPM_BIN\" ]; then echo 'Node.js/npm no están disponibles en el entorno de macOS.' >> " & quoted form of logFile & "; exit 127; fi; NODE_MAJOR=$(\"$NODE_BIN\" -p 'process.versions.node.split(\".\")[0]'); if [ \"$NODE_MAJOR\" != \"22\" ]; then echo \"ERROR: JobTrackr requiere Node.js 22.x; se encontró $($NODE_BIN -p 'process.version'). Instala/activa Node 22.23.2 con nvm.\" >> " & quoted form of logFile & "; exit 1; fi; run_npm(){ \"$NODE_BIN\" \"$NPM_BIN\" \"$@\"; }; NODE_ABI=$(\"$NODE_BIN\" -p 'process.versions.modules'); NODE_VERSION=$(\"$NODE_BIN\" -p 'process.version'); echo \"Using Node $NODE_VERSION (ABI $NODE_ABI)\" >> " & quoted form of logFile & "; if [ ! -d node_modules ] || [ ! -x node_modules/.bin/next ]; then echo 'Instalando dependencias...' >> " & quoted form of logFile & "; run_npm ci >> " & quoted form of logFile & " 2>&1 || exit $?; fi; if ! \"$NODE_BIN\" -e \"require('better-sqlite3')\" >/dev/null 2>&1; then echo \"Recompilando better-sqlite3 para Node $NODE_VERSION (ABI $NODE_ABI)...\" >> " & quoted form of logFile & "; run_npm rebuild better-sqlite3 --build-from-source >> " & quoted form of logFile & " 2>&1 || exit $?; fi; if ! \"$NODE_BIN\" -e \"require('better-sqlite3')\" >/dev/null 2>&1; then echo 'ERROR: better-sqlite3 sigue siendo incompatible con Node 22.' >> " & quoted form of logFile & "; exit 1; fi; currentCommit=$(git rev-parse HEAD 2>/dev/null || echo unknown); builtCommit=$(cat " & quoted form of buildCommitFile & " 2>/dev/null || echo ''); if [ ! -f apps/web/.next/BUILD_ID ] || [ \"$currentCommit\" != \"$builtCommit\" ]; then echo \"Generando build de producción para $currentCommit...\" >> " & quoted form of logFile & "; run_npm run build >> " & quoted form of logFile & " 2>&1 || exit $?; printf '%s' \"$currentCommit\" > " & quoted form of buildCommitFile & "; fi; if [ ! -f apps/web/.next/BUILD_ID ]; then echo 'ERROR: El build de producción de apps/web no contiene BUILD_ID.' >> " & quoted form of logFile & "; exit 1; fi; cd apps/web || exit 1; nohup \"$NODE_BIN\" ../../node_modules/next/dist/bin/next start -H 127.0.0.1 -p " & appPort & " >> " & quoted form of logFile & " 2>&1 < /dev/null & echo $! > " & quoted form of pidFile)
    do shell script launchCommand
    return my waitForServer()
end ensureServer

on waitForServer()
    repeat 60 times
        try
            set statusCode to do shell script "/usr/bin/curl -s -o /dev/null -w '%{http_code}' --max-time 2 http://127.0.0.1:" & appPort
            if statusCode is "200" or statusCode is "301" or statusCode is "302" or statusCode is "304" or statusCode is "307" or statusCode is "308" then return true
        end try
        delay 0.5
    end repeat
    return false
end waitForServer
